# =================================================================
# SNACK OVERFLOW - DOCKER COMPOSE ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env.docker before starting Docker Compose:
#   cp .env.docker.example .env.docker
# Replace placeholder values with secure credentials for your deployment.

# -----------------------------------------------------------------
# 1. PostgreSQL Database Container Configuration
# -----------------------------------------------------------------
POSTGRES_USER=snack_app
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=snack_overflow
# PostgreSQL 18 version-specific cluster data directory inside the volume mount (/var/lib/postgresql)
PGDATA=/var/lib/postgresql/18/docker

# -----------------------------------------------------------------
# 2. Backend Application Configuration
# -----------------------------------------------------------------
# Connection string pointing to internal Docker hostname 'postgres' on port 5432
DATABASE_URL=postgresql://snack_app:your_secure_postgres_password_here@postgres:5432/snack_overflow?schema=public

# Application ports and environment
PORT=4000
NODE_ENV=production

# Public URL of the frontend as accessed by the user's browser (used for CORS and CSRF verification)
FRONTEND_URL=http://localhost:3000

# Authentication & Session Security (Must be minimum 32 random characters in production)
JWT_SECRET=your_docker_jwt_secret_change_in_production_min_32_characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=snack_session

# Feature Flags
ENABLE_MEMBER_REGISTRATION=true

# -----------------------------------------------------------------
# 3. Frontend Web Application Configuration
# -----------------------------------------------------------------
# Public URL of the Backend API as accessed from the browser (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
