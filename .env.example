# ==========================================
# SNACK OVERFLOW - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env (or backend/.env and frontend/.env.local)
# and replace placeholder values with your environment settings.

# Backend Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection (Prisma)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
DATABASE_URL="postgresql://snack_app:your_password_here@localhost:5432/snack_overflow?schema=public"
TEST_DATABASE_URL="postgresql://snack_app:your_password_here@localhost:5432/snack_overflow_test?schema=public"

# Authentication Security
# Generate a secure 64+ character random string in production (e.g., openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_change_in_production_min_32_characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=snack_session

# Feature Flags
ENABLE_MEMBER_REGISTRATION=true

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
